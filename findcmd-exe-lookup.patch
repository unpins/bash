--- a/findcmd.c
+++ b/findcmd.c
@@ -553,6 +553,33 @@
   full_path = sh_makepath (xpath, name, 0);
 
   status = file_status (full_path);
+#ifdef __COSMOCC__
+  /* Windows: catalog programs install as "<name>.exe" hardlinks (so cmd.exe and
+     PowerShell resolve them via PATHEXT), but Cosmopolitan does not append an
+     executable suffix during path lookup, so a bare "ls" never resolves here.
+     When the unsuffixed candidate does not exist, retry once with ".exe"
+     appended and adopt that path if it resolves -- this mirrors how every
+     native Windows shell lets you omit the extension, and keeps a single
+     on-disk name (no bare "ls" duplicate cluttering the directory).  */
+  {
+    size_t cosmo_nl = strlen (name);
+    if ((status & FS_EXISTS) == 0
+        && (cosmo_nl < 4 || strcmp (name + cosmo_nl - 4, ".exe") != 0))
+      {
+        char *cosmo_exe = (char *) xmalloc (strlen (full_path) + 5);
+        strcpy (cosmo_exe, full_path);
+        strcat (cosmo_exe, ".exe");
+        if (file_status (cosmo_exe) & FS_EXISTS)
+          {
+            free (full_path);
+            full_path = cosmo_exe;
+            status = file_status (full_path);
+          }
+        else
+          free (cosmo_exe);
+      }
+  }
+#endif
 
   if (xpath != path)
     free (xpath);
